# ---------------------------------------------------------------------------
# Aurora Radio — environment template
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:8080

# Production toggles (auto-safe when DJANGO_DEBUG=false):
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty for local SQLite development.
# Production: postgres://user:pass@host:5432/dbname
DATABASE_URL=
POSTGRES_DB=aurora
POSTGRES_USER=aurora
POSTGRES_PASSWORD=change-me

# --- Station branding -------------------------------------------------------
STATION_NAME=Aurora Radio
STATION_TAGLINE=One live stream. The whole planet listening.
STATION_TIMEZONE=UTC
STATION_CONTACT_EMAIL=hello@auroraradio.example
STATION_CONTACT_ADDRESS=
STATION_SOCIAL_INSTAGRAM=
STATION_SOCIAL_X=
STATION_SOCIAL_YOUTUBE=
STATION_SOCIAL_FACEBOOK=
STATION_SOCIAL_TIKTOK=

# --- Streaming --------------------------------------------------------------
# Public URL the browser uses for audio (proxied through the frontend nginx).
STREAM_PUBLIC_URL=/live/radio
# Internal Icecast stats URL for measured listener counts (empty = no count shown).
ICECAST_STATS_URL=http://icecast:8000
ICECAST_MOUNT=radio
# Shared secret between Liquidsoap and Django internal endpoints.
BROADCAST_API_KEY=change-me-to-another-long-random-string

ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_ADMIN_PASSWORD=change-me-admin
ICECAST_RELAY_PASSWORD=change-me-relay
ICECAST_HOSTNAME=localhost

# --- Uploads ----------------------------------------------------------------
MAX_AUDIO_UPLOAD_MB=50
MAX_IMAGE_UPLOAD_MB=5
# For production object storage install django-storages and set:
# DEFAULT_STORAGE_BACKEND=storages.backends.s3boto3.S3Boto3Storage
# AWS_STORAGE_BUCKET_NAME=...
# AWS_S3_REGION_NAME=...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Email (console backend by default; set SMTP in production) -------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Aurora Radio <no-reply@auroraradio.example>

# --- Misc -------------------------------------------------------------------
WEB_PORT=8080
# Host port Icecast is published on. 8001 (not 8000) so it never collides
# with the Django dev server; containers still use icecast:8000 internally,
# and the Vite dev proxy forwards /live → localhost:8001.
ICECAST_PORT=8001
LOG_LEVEL=INFO

# --- Admin bootstrap --------------------------------------------------------
# Used by `init_station` (run automatically on container start, and available
# as a management command). Creates the first super-admin account.
ADMIN_EMAIL=admin@yourstation.fm
ADMIN_PASSWORD=change-me-now
# Run init_station on start (idempotent: only ensures the admin exists; never
# deletes content unless you pass --fresh manually).
INIT_STATION=true
